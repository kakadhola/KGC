<Window x:Class="KGC.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KGC Test Report - Print Preview" 
        Height="800" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="White"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Print Preview Content -->
        <ScrollViewer Grid.Row="0" Name="svPrintContent" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto"
                      Background="LightGray" Padding="20">
            
            <!-- A4 Paper Simulation -->
            <Border Background="White" 
                    BorderBrush="Gray" 
                    BorderThickness="1" 
                    Width="595" 
                    MinHeight="842"
                    HorizontalAlignment="Center"
                    Name="printableArea">
                
                <Grid Margin="40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Section -->
                    <Border Grid.Row="0" 
                            BorderBrush="#DAA520" 
                            BorderThickness="0,0,0,3" 
                            Padding="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Logo Area -->
                            <Border Grid.Column="0" 
                                    Width="70" Height="70" 
                                    Background="#FFFACD" 
                                    BorderBrush="#DAA520" 
                                    BorderThickness="2" 
                                    CornerRadius="5"
                                    VerticalAlignment="Top">
                                <TextBlock Text="LOGO" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" 
                                           FontWeight="Bold" 
                                           FontSize="10"
                                           Foreground="#2F4F4F"/>
                            </Border>

                            <!-- Company Information -->
                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                <TextBlock Text="KRUPA GOLD COMPANY" 
                                           FontSize="20" 
                                           FontWeight="Bold" 
                                           Foreground="#2F4F4F"/>
                                <TextBlock Text="Professional Gold &amp; Jewelry Testing Services" 
                                           FontSize="12" 
                                           FontStyle="Italic" 
                                           Foreground="#8B4513" 
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="Address: 123 Gold Street, Mumbai - 400001" 
                                           FontSize="10" 
                                           Foreground="#2F4F4F" 
                                           Margin="0,5,0,0"/>
                                <TextBlock Text="Phone: +91-22-12345678 | Email: info@krupagold.com" 
                                           FontSize="10" 
                                           Foreground="#2F4F4F"/>
                                <TextBlock Text="License No: MH/JEW/2023/0001" 
                                           FontSize="10" 
                                           Foreground="#2F4F4F"/>
                            </StackPanel>

                            <!-- Report Number -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="TEST REPORT" 
                                           FontSize="14" 
                                           FontWeight="Bold" 
                                           Foreground="#8B4513"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Name="txtReportNo" 
                                           Text="Report No: KGC-2024-0001" 
                                           FontSize="10" 
                                           Foreground="#2F4F4F"
                                           HorizontalAlignment="Right"
                                           Margin="0,5,0,0"/>
                                <TextBlock Name="txtReportDate" 
                                           Text="Date: 22/08/2024" 
                                           FontSize="10" 
                                           Foreground="#2F4F4F"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Test Information Section -->
                    <Border Grid.Row="2" 
                            BorderBrush="#DAA520" 
                            BorderThickness="1" 
                            Background="#FFFEF7">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" 
                                       Text="TEST INFORMATION" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="#2F4F4F"
                                       HorizontalAlignment="Center"/>

                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Party Name:" FontWeight="SemiBold" FontSize="10"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Name="lblPartyName" Text="" FontSize="10" Margin="5,0,0,0"/>
                                
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Item Name:" FontWeight="SemiBold" FontSize="10"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Name="lblItemName" Text="" FontSize="10" Margin="5,0,0,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Test Date:" FontWeight="SemiBold" FontSize="10" Margin="0,5,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Name="lblTestDate" Text="" FontSize="10" Margin="5,5,0,0"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Test Time:" FontWeight="SemiBold" FontSize="10" Margin="0,5,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Name="lblTestTime" Text="" FontSize="10" Margin="5,5,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Program Type:" FontWeight="SemiBold" FontSize="10" Margin="0,5,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Name="lblProgramType" Text="" FontSize="10" Margin="5,5,0,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Remarks:" FontWeight="SemiBold" FontSize="10" Margin="0,5,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Name="lblRemarks" Text="" FontSize="10" Margin="5,5,0,0" TextWrapping="Wrap"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Main Results Section -->
                    <Border Grid.Row="4" 
                            BorderBrush="#DAA520" 
                            BorderThickness="1" 
                            Background="White">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" 
                                       Text="MAIN TEST RESULTS" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="#2F4F4F"
                                       HorizontalAlignment="Center"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="#DAA520" BorderThickness="1" Margin="0,0,2,0">
                                    <StackPanel Margin="10" HorizontalAlignment="Center">
                                        <TextBlock Text="PURITY" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Foreground="#8B4513"/>
                                        <TextBlock Name="lblMainPurity" Text="" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="#2F4F4F"/>
                                        <TextBlock Text="%" FontSize="12" HorizontalAlignment="Center" Foreground="#2F4F4F"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" BorderBrush="#DAA520" BorderThickness="1" Margin="2,0,2,0">
                                    <StackPanel Margin="10" HorizontalAlignment="Center">
                                        <TextBlock Text="WEIGHT" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Foreground="#8B4513"/>
                                        <TextBlock Name="lblMainWeight" Text="" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="#2F4F4F"/>
                                        <TextBlock Text="grams" FontSize="12" HorizontalAlignment="Center" Foreground="#2F4F4F"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" BorderBrush="#DAA520" BorderThickness="1" Margin="2,0,0,0">
                                    <StackPanel Margin="10" HorizontalAlignment="Center">
                                        <TextBlock Text="AMOUNT" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Foreground="#8B4513"/>
                                        <TextBlock Name="lblMainAmount" Text="" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="#2F4F4F"/>
                                        <TextBlock Text="₹ INR" FontSize="12" HorizontalAlignment="Center" Foreground="#2F4F4F"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Detailed Measurements Table -->
                    <Border Grid.Row="6" 
                            BorderBrush="#DAA520" 
                            BorderThickness="1" 
                            Background="#FFFEF7">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" 
                                       Text="DETAILED MEASUREMENTS" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="#2F4F4F"
                                       HorizontalAlignment="Center"/>

                            <Grid Grid.Row="2" Name="metricsGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Metric headers will be populated by code-behind -->
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Footer Section -->
                    <Grid Grid.Row="8" Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tested By -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tested By:" FontWeight="Bold" FontSize="10" Foreground="#2F4F4F"/>
                            <Border BorderBrush="#DAA520" BorderThickness="0,0,0,1" Margin="0,20,0,0" Width="150" HorizontalAlignment="Left"/>
                            <TextBlock Text="Technician Name" FontSize="9" Foreground="#2F4F4F" Margin="0,5,0,0"/>
                            <TextBlock Text="License: KGC-TECH-001" FontSize="8" Foreground="#8B4513"/>
                        </StackPanel>

                        <!-- Authorized By -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="Authorized By:" FontWeight="Bold" FontSize="10" Foreground="#2F4F4F"/>
                            <Border BorderBrush="#DAA520" BorderThickness="0,0,0,1" Margin="0,20,0,0" Width="150"/>
                            <TextBlock Text="Lab Director" FontSize="9" Foreground="#2F4F4F" Margin="0,5,0,0"/>
                            <TextBlock Text="License: KGC-DIR-001" FontSize="8" Foreground="#8B4513"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="1" 
                Background="{StaticResource LightGoldBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1,1,1,0" 
                Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="btnPrintPreview" Content="Print Preview" 
                        Style="{StaticResource GoldenButtonStyle}" 
                        Width="120" Height="35" Margin="0,0,10,0"
                        Click="BtnPrintPreview_Click"/>
                <Button Name="btnPrint" Content="Print" 
                        Style="{StaticResource GoldenButtonStyle}" 
                        Width="100" Height="35" Margin="0,0,10,0"
                        Click="BtnPrint_Click"/>
                <Button Name="btnClose" Content="Close" 
                        Style="{StaticResource GoldenButtonStyle}" 
                        Width="100" Height="35"
                        Click="BtnClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>