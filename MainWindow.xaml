<Window x:Class="KGC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KGC - Krupa Gold Company Testing System" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Icon="Resources/icon.ico">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource PrimaryGoldBrush}" 
                BorderBrush="{StaticResource DarkGoldBrush}" 
                BorderThickness="3" 
                CornerRadius="5" 
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="20,15">
                <Border Width="80" Height="80" 
                        Background="{StaticResource LightGoldBrush}" 
                        BorderBrush="{StaticResource DarkGoldBrush}" 
                        BorderThickness="2" 
                        CornerRadius="5"
                        Margin="0,0,20,0">
                    <TextBlock Text="LOGO" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               FontWeight="Bold" 
                               FontSize="14"
                               Foreground="{StaticResource TextBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="KRUPA GOLD COMPANY" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Professional Gold &amp; Jewelry Testing Services" 
                               FontSize="16" 
                               FontStyle="Italic" 
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Certified • Accurate • Reliable" 
                               FontSize="12" 
                               Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    
                    <!-- Test Information -->
                    <GroupBox Header="Test Information" Style="{StaticResource GoldenGroupBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Party Name:" Style="{StaticResource GoldenLabelStyle}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Name="cmbPartyName" 
                                      Style="{StaticResource GoldenComboBoxStyle}" Margin="0,0,0,5"
                                      IsEditable="True"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Item Name:" Style="{StaticResource GoldenLabelStyle}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Name="cmbItemName" 
                                      Style="{StaticResource GoldenComboBoxStyle}" Margin="0,0,0,5"
                                      IsEditable="True"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Test Date:" Style="{StaticResource GoldenLabelStyle}"/>
                            <DatePicker Grid.Row="2" Grid.Column="1" Name="dpTestDate" 
                                        BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,5"/>

                            <Label Grid.Row="3" Grid.Column="0" Content="Test Time:" Style="{StaticResource GoldenLabelStyle}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Name="txtTestTime" 
                                     Style="{StaticResource GoldenTextBoxStyle}" Margin="0,0,0,5"
                                     IsReadOnly="True"/>

                            <Label Grid.Row="4" Grid.Column="0" Content="Remarks:" Style="{StaticResource GoldenLabelStyle}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Name="txtRemarks" 
                                     Style="{StaticResource GoldenTextBoxStyle}" 
                                     Height="60" TextWrapping="Wrap" 
                                     VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </GroupBox>

                    <!-- Program Type Selection -->
                    <GroupBox Header="Program Type" Style="{StaticResource GoldenGroupBoxStyle}">
                        <StackPanel>
                            <RadioButton Name="rbKrupaGold" Content="Krupa Gold" 
                                         FontWeight="SemiBold" Margin="0,0,0,5" 
                                         Foreground="{StaticResource TextBrush}" IsChecked="True"/>
                            <RadioButton Name="rbFineGold" Content="Fine Gold" 
                                         FontWeight="SemiBold" Margin="0,0,0,5" 
                                         Foreground="{StaticResource TextBrush}"/>
                            <RadioButton Name="rbSilverOrnament" Content="Silver Ornament" 
                                         FontWeight="SemiBold" Margin="0,0,0,5" 
                                         Foreground="{StaticResource TextBrush}"/>
                            <RadioButton Name="rbOtherMetal" Content="Other Metal" 
                                         FontWeight="SemiBold" 
                                         Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Main Results -->
                    <GroupBox Header="Main Results" Style="{StaticResource GoldenGroupBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Purity:" Style="{StaticResource GoldenLabelStyle}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Name="txtMain_1" 
                                     Style="{StaticResource GoldenTextBoxStyle}" Margin="0,0,5,5"/>
                            <Label Grid.Row="0" Grid.Column="2" Content="%" Style="{StaticResource GoldenLabelStyle}"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Weight:" Style="{StaticResource GoldenLabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Name="txtMain_2" 
                                     Style="{StaticResource GoldenTextBoxStyle}" Margin="0,0,5,5"/>
                            <Label Grid.Row="1" Grid.Column="2" Content="g" Style="{StaticResource GoldenLabelStyle}"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Amount:" Style="{StaticResource GoldenLabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Name="txtMain_3" 
                                     Style="{StaticResource GoldenTextBoxStyle}" Margin="0,0,5,0"/>
                            <Label Grid.Row="2" Grid.Column="2" Content="₹" Style="{StaticResource GoldenLabelStyle}"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>

                <!-- Right Column -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    
                    <!-- Detailed Metrics -->
                    <GroupBox Header="Detailed Measurements" Style="{StaticResource GoldenGroupBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- First Column of Metrics -->
                            <Label Grid.Row="0" Grid.Column="0" Content="Metric 1:" Style="{StaticResource GoldenLabelStyle}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Name="txtMetric1" Style="{StaticResource GoldenTextBoxStyle}" Margin="0,0,5,5"/>
                            
                            <Label Grid.Row="1" Grid.Column="0" Content="Metric 2:" Style="{StaticResource GoldenLabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Name="txtMetric2" Style="{StaticResource GoldenTextBoxStyle}" Margin="0,0,5,5"/>
                            
                            <Label Grid.Row="2" Grid.Column="0" Content="Metric 3:" Style="{StaticResource GoldenLabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Name="txtMetric3" Style="{StaticResource GoldenTextBoxStyle}" Margin="0,0,5,5"/>
                            
                            <Label Grid.Row="3" Grid.Column="0" Content="Metric 4:" Style="{StaticResource GoldenLabelStyle}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Name="txtMetric4" Style="{StaticResource GoldenTextBoxStyle}" Margin="0,0,5,5"/>
                            
                            <Label Grid.Row="4" Grid.Column="0" Content="Metric 5:" Style="{StaticResource GoldenLabelStyle}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Name="txtMetric5" Style="{StaticResource GoldenTextBoxStyle}" Margin="0,0,5,5"/>
                            
                            <Label Grid.Row="5" Grid.Column="0" Content="Metric 6:" Style="{StaticResource GoldenLabelStyle}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Name="txtMetric6" Style="{StaticResource GoldenTextBoxStyle}" Margin="0,0,5,5"/>

                            <!-- Second Column of Metrics -->
                            <Label Grid.Row="0" Grid.Column="2" Content="Metric 7:" Style="{StaticResource GoldenLabelStyle}"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Name="txtMetric7" Style="{StaticResource GoldenTextBoxStyle}" Margin="0,0,0,5"/>
                            
                            <Label Grid.Row="1" Grid.Column="2" Content="Metric 8:" Style="{StaticResource GoldenLabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Name="txtMetric8" Style="{StaticResource GoldenTextBoxStyle}" Margin="0,0,0,5"/>
                            
                            <Label Grid.Row="2" Grid.Column="2" Content="Metric 9:" Style="{StaticResource GoldenLabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Name="txtMetric9" Style="{StaticResource GoldenTextBoxStyle}" Margin="0,0,0,5"/>
                            
                            <Label Grid.Row="3" Grid.Column="2" Content="Metric 10:" Style="{StaticResource GoldenLabelStyle}"/>
                            <TextBox Grid.Row="3" Grid.Column="3" Name="txtMetric10" Style="{StaticResource GoldenTextBoxStyle}" Margin="0,0,0,5"/>
                            
                            <Label Grid.Row="4" Grid.Column="2" Content="Metric 11:" Style="{StaticResource GoldenLabelStyle}"/>
                            <TextBox Grid.Row="4" Grid.Column="3" Name="txtMetric11" Style="{StaticResource GoldenTextBoxStyle}" Margin="0,0,0,5"/>
                            
                            <Label Grid.Row="5" Grid.Column="2" Content="Metric 12:" Style="{StaticResource GoldenLabelStyle}"/>
                            <TextBox Grid.Row="5" Grid.Column="3" Name="txtMetric12" Style="{StaticResource GoldenTextBoxStyle}" Margin="0,0,0,5"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Footer with Action Buttons -->
        <Border Grid.Row="2" 
                Background="{StaticResource LightGoldBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="3" 
                Margin="0,10,0,0"
                Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="btnClear" Content="Clear All" 
                        Style="{StaticResource GoldenButtonStyle}" 
                        Width="100" Height="35" Margin="0,0,10,0"
                        Click="BtnClear_Click"/>
                <Button Name="btnSave" Content="Save Data" 
                        Style="{StaticResource GoldenButtonStyle}" 
                        Width="100" Height="35" Margin="0,0,10,0"
                        Click="BtnSave_Click"/>
                <Button Name="btnPrint" Content="Print Report" 
                        Style="{StaticResource GoldenButtonStyle}" 
                        Width="120" Height="35"
                        Click="BtnPrint_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>